# Database
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://naviassist:change_me_strong_password@localhost:5432/naviassist

# Redis
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@localhost:6379

# Auth
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret

# AI Services
GROQ_API_KEY=

# URLs
API_URL=https://api.naviassist.app
WS_URL=wss://api.naviassist.app

# Storage (AWS S3 or Cloudflare R2)
S3_BUCKET=naviassist-media
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=<access_key>
AWS_SECRET_ACCESS_KEY=<secret_key>

# Notifications
FCM_SERVER_KEY=<fcm_key>
APNS_KEY_ID=<apns_key>

# Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=<resend_api_key>
FROM_EMAIL=noreply@naviassist.app

# Twilio (SMS/OTP)
TWILIO_ACCOUNT_SID=<sid>
TWILIO_AUTH_TOKEN=<token>
TWILIO_PHONE=+1...

# Sentry
SENTRY_DSN=https://...
