    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@fastify/websocket": "^10.0.1",
    "@prisma/client": "^5.14.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "nodemailer": "^6.9.14",
    "pino": "^9.3.1",
    "pino-pretty": "^13.1.3",
    "twilio": "^5.2.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
